ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/CJBaseUIKit-Swift" "${PODS_CONFIGURATION_BUILD_DIR}/CJFeatureGRView" "${PODS_CONFIGURATION_BUILD_DIR}/CJGRKit" "${PODS_CONFIGURATION_BUILD_DIR}/CJViewElement-Swift" "${PODS_CONFIGURATION_BUILD_DIR}/CJViewGR-Swift" "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit" "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit-Swift" "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoResource" "${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_GRKit" "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_GRKit-Swift" "${PODS_CONFIGURATION_BUILD_DIR}/UIPathCJHelper"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/CJBaseUIKit-Swift/CJBaseUIKit_Swift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CJFeatureGRView/CJFeatureGRView.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CJGRKit/CJGRKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CJViewElement-Swift/CJViewElement_Swift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CJViewGR-Swift/CJViewGR_Swift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit-Swift/CQDemoKit_Swift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit/CQDemoKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoResource/CQDemoResource.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Masonry/Masonry.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit/SnapKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_GRKit-Swift/TSDemo_GRKit_Swift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_GRKit/TSDemo_GRKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/UIPathCJHelper/UIPathCJHelper.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift $(SDKROOT)/usr/lib/swift
OTHER_CFLAGS = $(inherited) -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CJBaseUIKit-Swift/CJBaseUIKit_Swift.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CJFeatureGRView/CJFeatureGRView.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CJGRKit/CJGRKit.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CJViewElement-Swift/CJViewElement_Swift.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CJViewGR-Swift/CJViewGR_Swift.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit-Swift/CQDemoKit_Swift.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit/CQDemoKit.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoResource/CQDemoResource.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Masonry/Masonry.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit/SnapKit.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_GRKit/TSDemo_GRKit.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_GRKit-Swift/TSDemo_GRKit_Swift.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/UIPathCJHelper/UIPathCJHelper.framework/Headers" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CJBaseUIKit-Swift" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CJFeatureGRView" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CJGRKit" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CJViewElement-Swift" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CJViewGR-Swift" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit-Swift" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoResource" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Masonry" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_GRKit" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_GRKit-Swift" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/UIPathCJHelper"
OTHER_LDFLAGS = $(inherited) -l"swiftCoreGraphics" -framework "CJBaseUIKit_Swift" -framework "CJFeatureGRView" -framework "CJGRKit" -framework "CJViewElement_Swift" -framework "CJViewGR_Swift" -framework "CQDemoKit" -framework "CQDemoKit_Swift" -framework "CQDemoResource" -framework "Foundation" -framework "Masonry" -framework "SnapKit" -framework "TSDemo_GRKit" -framework "TSDemo_GRKit_Swift" -framework "UIKit" -framework "UIPathCJHelper"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/CJBaseUIKit-Swift" "-F${PODS_CONFIGURATION_BUILD_DIR}/CJFeatureGRView" "-F${PODS_CONFIGURATION_BUILD_DIR}/CJGRKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/CJViewElement-Swift" "-F${PODS_CONFIGURATION_BUILD_DIR}/CJViewGR-Swift" "-F${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit-Swift" "-F${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/CQDemoResource" "-F${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "-F${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_GRKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_GRKit-Swift" "-F${PODS_CONFIGURATION_BUILD_DIR}/UIPathCJHelper"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
